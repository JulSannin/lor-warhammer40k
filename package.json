{
  "name": "lor-warhammer40k",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "images": "node --experimental-strip-types scripts/fetch-images.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-loading-skeleton": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
